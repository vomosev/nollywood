# ---------------------------------------------------------------------------
# Nollywood — example environment configuration
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit a real .env file or real secrets to version control.
# ---------------------------------------------------------------------------

# ----------------------------- Runtime -------------------------------------
# Port the Express API binds to (assigned by the deploy script).
# The Next.js frontend runs separately on 4109 (dev) / 50109-fronted domain.
PORT=50109

# Node environment: development | production | test
NODE_ENV=development

# ----------------------------- Database (MySQL) -----------------------------
# Host that MySQL is reachable on.
DB_HOST=localhost

# MySQL user with rights on DB_NAME.
DB_USER=nollywood_user

# MySQL password — replace with your own value.
DB_PASSWORD=change_me_database_password

# Database that schema.sql was applied to.
DB_NAME=nollywood

# ----------------------------- Sessions -------------------------------------
# Secret used to sign the session cookie. Use a long random string in production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
SESSION_SECRET=change_me_to_a_long_random_session_secret

# Cookie domain so the session cookie is shared across arx-app.com subdomains
# (nollywood.arx-app.com <-> nollywood-api.arx-app.com).
SESSION_COOKIE_DOMAIN=.arx-app.com

# ----------------------------- TLS / HTTPS ----------------------------------
# Set to 'true' to terminate TLS directly inside the Express process.
# When 'false' (or unset) the API starts a plain HTTP server instead.
SSL_ENABLED=true

# Absolute path to the TLS certificate.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA bundle (leave blank if not required).
SSL_CA_PATH=

# ----------------------------- Public URLs ----------------------------------
# Base URL the browser uses to reach the Express API.
NEXT_PUBLIC_API_BASE_URL=https://nollywood-api.arx-app.com:50109

# Public URL of the Next.js frontend.
NEXT_PUBLIC_SITE_URL=https://nollywood.arx-app.com